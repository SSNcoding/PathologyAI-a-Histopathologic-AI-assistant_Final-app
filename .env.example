# Copy to .env and fill in for a real deployment. Never commit a real .env file.
PATHOLOGYAI_SECRET_KEY=change-me-to-a-long-random-string
PATHOLOGYAI_DB_PATH=output/data/pathologyai.db
PATHOLOGY_LLM_ENDPOINT=

# Pathology Assistant (services/assistant.py) — only needed for live AI chat;
# app falls back to a rule-based responder if unset. On Streamlit Community
# Cloud, set GROQ_API_KEY via the Secrets panel instead (see
# .streamlit/secrets.toml.example). On Docker/Render/other PaaS hosts, set it
# as a plain env var here or in your platform's dashboard.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Production hardening (see config/settings.py) — set PATHOLOGYAI_ENV=production
# to make the app refuse to boot with the default insecure SECRET_KEY.
PATHOLOGYAI_ENV=development
PATHOLOGYAI_SESSION_TIMEOUT_MINUTES=60

# Optional Postgres backend (db/database.py) — leave unset to keep using
# SQLite. Also requires `pip install psycopg2-binary`.
DATABASE_URL=

# Optional SSO/OAuth login (services/oauth_service.py) — leave all unset to
# keep the local username/password login as the only option. All five must
# be set together to activate; see the module docstring for provider setup.
PATHOLOGYAI_OAUTH_CLIENT_ID=
PATHOLOGYAI_OAUTH_CLIENT_SECRET=
PATHOLOGYAI_OAUTH_AUTHORIZE_URL=
PATHOLOGYAI_OAUTH_TOKEN_URL=
PATHOLOGYAI_OAUTH_USERINFO_URL=
PATHOLOGYAI_OAUTH_REDIRECT_URI=http://localhost:8501
PATHOLOGYAI_OAUTH_PROVIDER_LABEL=Google

# Optional FastAPI layer (api_server.py) — leave unset for an open/dev API.
PATHOLOGYAI_API_KEY=
